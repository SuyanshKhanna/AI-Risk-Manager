# ============================================================
# AI Risk Manager — UPI Fraud Detector Configuration
# ============================================================
# Copy this file to .env and fill in your values
# For local development: cp .env.example .env
# ============================================================

# ------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------
APP_NAME="ai-risk-manager"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------
# SERVER SETTINGS
# ------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
WORKERS=1  # Increase for production (e.g., 4)

# ------------------------------------------------------------------
# MODEL SETTINGS
# ------------------------------------------------------------------
MODEL_PATH="./models/upi_fraud_lgbm"
MODEL_VERSION=""  # Auto-detected from model directory if empty

# Decision thresholds
CHALLENGE_THRESHOLD=0.3   # Score >= 0.3 -> CHALLENGE
BLOCK_THRESHOLD=0.7       # Score >= 0.7 -> BLOCK
FP_COST_PER_BLOCKED_TXN=150.0  # INR cost of false positive

# LightGBM parameters (JSON string or leave empty for defaults)
# LGB_PARAMS='{"objective": "binary", "metric": "binary_logloss", "num_leaves": 31, "learning_rate": 0.05, "feature_fraction": 0.8, "bagging_fraction": 0.8, "bagging_freq": 5, "min_child_samples": 20, "verbose": -1, "num_threads": 4}'

# Training settings
TEST_SIZE=0.2
VAL_SIZE=0.1
CALIBRATE=true  # Use isotonic calibration
EARLY_STOPPING_ROUNDS=50
NUM_BOOST_ROUND=500

# ------------------------------------------------------------------
# DATA SETTINGS
# ------------------------------------------------------------------
DATA_DIR="./data/upi_fraud"
TRAINING_DATA_FILE="upi_fraud_training.parquet"
SYNTHETIC_DATA_CONFIG='{"n_legitimate": 50000, "n_fraud": 500, "add_rolling": true}'

# ------------------------------------------------------------------
# FEATURE STORE (Production - not used in MVP)
# ------------------------------------------------------------------
# FEAST_REPO_PATH="./feature_store"
# FEAST_ONLINE_STORE_TYPE="redis"  # redis | sqlite
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=""

# ------------------------------------------------------------------
# DATABASE (Production - not used in MVP)
# ------------------------------------------------------------------
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/ai_risk"
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------
# MESSAGE QUEUE (Production - not used in MVP)
# ------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
# KAFKA_TOPIC_RAW_TXNS="raw.transactions"
# KAFKA_TOPIC_SCORED_TXNS="scored.transactions"
# KAFKA_CONSUMER_GROUP="upi-fraud-detector"

# ------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ------------------------------------------------------------------
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_PATH="/metrics"

# Structured Logging
LOG_FORMAT="json"  # json | text
LOG_FILE=""  # Empty = stdout only
LOG_ROTATION="1 day"
LOG_RETENTION="30 days"

# Tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="upi-fraud-detector"

# ------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------
# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=60
JWT_ISSUER="ai-risk-manager"
JWT_AUDIENCE="upi-fraud-detector"

# API Keys
API_KEY_ENABLED=false
API_KEY_HEADER="X-API-Key"
API_KEY_PREFIX="ak_"

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_FUNC="client_ip"  # client_ip | api_key | user_id

# CORS
CORS_ENABLED=true
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8080"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET", "POST", "OPTIONS"]'
CORS_ALLOW_HEADERS='["*"]'

# ------------------------------------------------------------------
# EXTERNAL SERVICES (Production)
# ------------------------------------------------------------------
# MLflow
# MLFLOW_TRACKING_URI="http://localhost:5000"
# MLFLOW_EXPERIMENT_NAME="upi-fraud-detection"

# MinIO / S3 (Model artifacts)
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="models"
# S3_REGION="us-east-1"

# ------------------------------------------------------------------
# GRPC (Production - not used in MVP HTTP-only)
# ------------------------------------------------------------------
# GRPC_ENABLED=false
# GRPC_PORT=50051
# GRPC_MAX_WORKERS=10

# ------------------------------------------------------------------
# STR ESTIMATOR (Production - not used in MVP)
# ------------------------------------------------------------------
# STR_ENABLED=false
# STR_CONFIG='{"propensity_model": "lightgbm", "outcome_model": "lightgbm", "corruption_model": "beta_binomial", "shrinkage_enabled": true, "n_folds": 5, "shrinkage_min_samples": 100}'

# ------------------------------------------------------------------
# TFT MODEL (Production - not used in MVP)
# ------------------------------------------------------------------
# TFT_ENABLED=false
# TFT_MODEL_PATH="./models/tft_model.pt"
# TFT_SEQ_LEN=30
# TFT_HIDDEN_SIZE=64
# TFT_NUM_HEADS=4
# TFT_DROPOUT=0.1

# ------------------------------------------------------------------
# VOICE AUTH (Production - not used in MVP)
# ------------------------------------------------------------------
# VOICE_AUTH_ENABLED=false
# VOICE_MODEL_PATH="./models/voice_auth.pt"
# VOICE_SAMPLE_RATE=16000

# ------------------------------------------------------------------
# KYC / CHARGEBACK / RETURNS (Production - not used in MVP)
# ------------------------------------------------------------------
# KYC_ENABLED=false
# KYC_API_URL="https://kyc-provider.example.com"
# KYC_API_KEY=""

# CHARGEBACK_ENABLED=false
# CHARGEBACK_API_URL="https://chargeback-provider.example.com"

# RETURNS_ENABLED=false
# RETURNS_API_URL="https://returns-provider.example.com"